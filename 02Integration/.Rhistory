library(tidyverse)
library(gliomaData)
data("ge_cgh_locIGR")
GE <- ge_cgh_locIGR$multiblocks$GE
summary(GE)
dim(GE)
CGH <- ge_cgh_locIGR$multiblocks$CGH
dim(CGH)
moyennes <- apply(GE, 2, mean)
GE_norm <- GE - moyennes
#library(FactoMineR)
library(RGCCA)
C <- matrix(data = c(0, 1, 1, 0), 2, 2)
acp_ge <- rgcca(blocks = GE_norm, C=C, tau = 1, method = "pca")
C
View(ge_cgh_locIGR)
