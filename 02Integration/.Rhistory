library(tidyverse)
library(gliomaData)
data("ge_cgh_locIGR")
ge <- ge_cgh_locIGR$multiblocks$GE
dim(ge)
cgh <- ge_cgh_locIGR$multiblocks$CGH
dim(cgh)
head(res.pca$sdev)
res.pca <- prcomp(ge, scale. = FALSE)
names(res.pca)
head(res.pca$sdev)
head(res.pca$rotation)
head(res.pca$center)
head(res.pca$scale)
head(res.pca$x, n = 6)
library(factoextra)
loc <- factor(c("cort", "dipg", "midl")[ge_cgh_locIGR$ylabel])
fviz_screeplot(res.pca)
fviz_pca_ind(res.pca, geom = "point", col.ind = loc, invisible = "quali")
res.pca.scale <- prcomp(ge, scale. = TRUE)
fviz_pca_var(res.pca.scale, select.var = list(contrib = 7), repel = TRUE)
res.pca$x[1:6, 1:7]
head(res.pca$x, c(6, 7))
head(res.pca$rotation, c(10, 5))
library(ggplot2)
library(dplyr)
get_eigenvalue(res.pca) %>%
as_tibble(rownames = "Dimension") %>%
mutate(group = 1) %>%
ggplot(aes(x = Dimension, y = cumulative.variance.percent)) +
geom_col(fill = "steelblue") +
geom_point(color = "black", size = 3) +
geom_line(aes(group = group), color = "black", size = 1)
get_eigenvalue(res.pca)
library(ggplot2)
library(dplyr)
get_eigenvalue(res.pca) %>%
mutate(Dimension = factor(seq(1:n()), labels = sprintf("Dim. %i", 1:n()))) %>%
ggplot(aes(x = Dimension, y = cumulative.variance.percent)) +
geom_col(fill = "steelblue") +
geom_hline(yintercept = 80, color = "limegreen") +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5)) +
labs(x = "", y = "Cumulative percentage of explained variance")
