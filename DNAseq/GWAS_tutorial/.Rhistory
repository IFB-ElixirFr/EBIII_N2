# Création du data.frame .fam
new_fam <- data.frame(
FID = ped$Family.ID,
IID = ped$Individual.ID,
Father_ID = ped$Paternal.ID,
Mother_ID = ped$Maternal.ID,
Sex = ped$Gender,
Phenotype = -9
)
rownames(new_fam) <- new_fam$IID
# On en garde que les individus de l'ancien fichier fam
new_fam_subpop <- new_fam[rownames(fam),]
head(fam)
fam <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/1000G_chr22/chr22.fam", sep = "\t", stringsAsFactors = FALSE, row.names = 2, h=F)
head(fam)
head(new_fam)
head(new_fam_subpop)
# Création du data.frame .fam
new_fam <- data.frame(
FID = ped$Family.ID,
IID = ped$Individual.ID,
Father_ID = ped$Paternal.ID,
Mother_ID = ped$Maternal.ID,
Sex = ped$Gender,
Phenotype = -9
)
rownames(new_fam) <- new_fam$IID
# On en garde que les individus de l'ancien fichier fam
new_fam_subpop <- new_fam[rownames(fam),]
head(new_fam_subpop)
# Écriture du fichier .fam (sans en-tête, séparé par des espaces)
write.table(
new_fam_subpop,
file = "~/Enseignements/EBAII_niv2_2025/GWAS/1000G_chr22/chr22.new.fam",
sep = " ",
quote = FALSE,
row.names = FALSE,
col.names = FALSE
)
1kg_fam <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/1000genomes-20250516T121755Z-1-001/1000genomes/1kg_extract.fam", sep = "\t", stringsAsFactors = FALSE, row.names = 2, h=F)
kg_fam <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/1000genomes-20250516T121755Z-1-001/1000genomes/1kg_extract.fam", sep = "\t", stringsAsFactors = FALSE, row.names = 2, h=F)
kg_fam <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/1000genomes-20250516T121755Z-1-001/1000genomes/1kg_extract.fam", sep = " ", stringsAsFactors = FALSE, row.names = 2, h=F)
head(kg_fam)
setdiff(rownames(kg_fam), rownames(new_fam_subpop))
write.table(
new_fam_subpop,
file = "~/Enseignements/EBAII_niv2_2025/GWAS/1000genomes-20250516T121755Z-1-001/1000genomes/1kg_extract.new.fam",
sep = " ",
quote = FALSE,
