# Chargement du fichier
ped <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/integrated_call_samples_v3.20200731.ALL.ped", sep = "\t", stringsAsFactors = FALSE)
fam <- read.delim("~/Enseignements/EBAII_niv2_2025/GWAS/1000G_chr22/chr22.fam", sep = "\t", stringsAsFactors = FALSE, row.names = 2)
