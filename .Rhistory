## Mini-heatmap (only IL)
hm <- pheatmap(t(covid_num_IL), annotation_col = pheno, show_colnames = FALSE)
gg_CD4
hm + gg_CD4
hm
hm$gtable + gg_CD4
(hm$gtable) + gg_CD4
library(patchwork)
(hm$gtable) + gg_CD4
gg_CD4 + gg_CD4
gg_CD4 + hm$gtable
hm$gtable + gg_CD4
plot(hm$gtable + gg_CD4)
(hm$gtable) / gg_CD4
hm$gtable / gg_CD4
(gg_CD4 + gg_CD4) /
