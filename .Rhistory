# ---- LIBRAIRIES ----
library(tidyverse)
set.seed(123)  # Reproductibilité
# ---- PARAMÈTRES GLOBAUX ----
n <- 500
prop_deaths <- 0.32  # Environ 32 % de décès comme dans l’étude
# ---- GÉNÉRATION DES DONNÉES ----
status <- rbinom(n, 1, prop_deaths)  # 1 = mort, 0 = survie
age <- ifelse(
status == 1,
round(rnorm(n, mean = 5, sd = 4)),  # décès = plus jeunes en moyenne
round(rnorm(n, mean = 7, sd = 4))
)
age[age < 0] <- 0
sex <- sample(c("Male", "Female"), size = n, replace = TRUE, prob = c(0.52, 0.48))
health_insurance <- rbinom(n, 1, ifelse(status == 1, 0.45, 0.70))  # Moins souvent assuré si décès
referral <- rbinom(n, 1, ifelse(status == 1, 0.65, 0.45))  # Décès = plus souvent référé
malaria_severity <- ifelse(
status == 1,
sample(c("Severe", "Uncomplicated"), size = n, replace = TRUE, prob = c(0.85, 0.15)),
sample(c("Severe", "Uncomplicated"), size = n, replace = TRUE, prob = c(0.35, 0.65))
)
anaemia <- rbinom(n, 1, ifelse(malaria_severity == "Severe", 0.7, 0.2))
hospital_stay_days <- round(rlnorm(n, meanlog = 1.5, sdlog = 0.6))
hospital_stay_days[hospital_stay_days > 30] <- 30
region <- sample(c("Northern", "Upper West", "Upper East"),
size = n, replace = TRUE, prob = c(0.6, 0.2, 0.2))
# ---- CONSTRUCTION DU DATAFRAME ----
malaria_df <- tibble(
status = factor(status, levels = c(0, 1), labels = c("Survived", "Died")),
age,
sex,
health_insurance = factor(health_insurance, levels = c(0, 1), labels = c("No", "Yes")),
referral = factor(referral, levels = c(0, 1), labels = c("No", "Yes")),
malaria_severity = factor(malaria_severity),
anaemia = factor(anaemia, levels = c(0, 1), labels = c("No", "Yes")),
hospital_stay_days,
region = factor(region)
)
# ---- SAUVEGARDE CSV ----
write_csv(malaria_df, "malaria_simulated.csv")
# Figure similaire à la Fig. 1 : âge par statut
ggplot(malaria_df, aes(x = status, y = age, fill = status)) +
geom_boxplot() +
labs(title = "Age distribution by patient outcome", y = "Age (years)", x = "") +
theme_minimal()
# Figure similaire à la Fig. 2 : gravité vs décès
ggplot(malaria_df, aes(x = malaria_severity, fill = status)) +
geom_bar(position = "fill") +
labs(title = "Malaria severity by outcome", y = "Proportion", x = "Severity") +
theme_minimal()
# Figure similaire à la Fig. 3 : présence de l’assurance maladie par statut
ggplot(malaria_df, aes(x = health_insurance, fill = status)) +
geom_bar(position = "fill") +
labs(title = "Health insurance coverage by outcome", y = "Proportion", x = "Insured") +
theme_minimal()
