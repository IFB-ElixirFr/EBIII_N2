library(readr)
library(dplyr)
library(ggplot2)
setwd("~/git/EBIII_N2/01R")
covid <- read_csv("data/covid.csv")
pheatmap(covid %>% select(ABCB1:BID))
library(pheatmap)
pak::pak("pheatmap")
pheatmap(covid %>% select(IL10:ILF3))
library(pheatmap)
covid <- read_csv("data/covid.csv")
pheatmap(covid %>% select(IL10:ILF3))
pheno <- covid %>% select(time, status)
pheatmap(covid %>% select(IL10:ILF3), annotation_row = pheno)
pheno <- as.data.frame(covid %>% select(time, status))
covid_num_IL <- as.matrix(covid %>% select(IL10:ILF3))
rownames(covid_num_IL) <- rownames(pheno) <- covid$id
covid$id
View(pheno)
rownames(covid_num_IL) <- rownames(pheno) <- paste0(
covid$id,
ifelse(
covid$status == "nCOV",
paste0("-",covid$time),
""))
rownames(covid_num_IL)
pheatmap(covid_num_IL, annotation_row = pheno)
pheatmap(t(covid_num_IL), annotation_col = pheno, show_colnames = FALSE)
library(patchwork)
## CD4 plot
gg_CD4 <- covid |>
filter(status == "nCOV") |>
ggplot(aes(
x = time, y = CD4,
color = id, shape = id)) +
geom_ribbon(
mapping = aes(
x = time, ymin = ymin,
ymax = ymax, y = y),
data = hc,
fill = "lightgrey",
inherit.aes = FALSE) +
geom_hline(
yintercept = hc$y,
linetype = "dashed") +
geom_point() +
geom_line() +
scale_color_manual(values = c(
"Case1" = "red",
"Case2" = "blue",
"Case3" = "orange")) +
scale_x_continuous(
limits = c(3, 20),
expand = c(0, 0)) +
theme_classic() +
theme(plot.title = element_text(hjust = 0.5)) +
labs(
x = "Days after illness onset",
y = bquote(Normalized~log[2]~expression),
title = "CD4",
color = "", shape = "")
