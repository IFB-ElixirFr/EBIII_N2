geom_ribbon(
mapping = aes(x = time, ymin = ymin, ymax = ymax, y = y),
data = hc,
inherit.aes = FALSE) +
geom_hline(
yintercept = hc$y,
linetype = "dashed") +
scale_color_manual(values = c(
"Case1" = "red",
"Case2" = "blue",
"Case3" = "orange")) +
scale_x_continuous(
breaks = 3:20,
limits = c(3, 20),
expand = c(0, 0)) +  theme_classic() +
theme(plot.title = element_text(hjust = 0.5)) +
labs(
x = "Days after illness onset",
y = "Normalized log2 expression",
title = "CD4",
color = "", shape = "")
